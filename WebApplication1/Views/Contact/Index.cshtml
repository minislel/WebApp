    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<WebApplication1.Models.ContactModel>

@{
    ViewBag.Title = "Index";
  Layout = "_Layout";
}

<h2>Kontakty</h2>
<a class="btn btn-primary" asp-action="Add" asp-controller="Contact">Add</a>
<table class="table">
    <thead>
        <tr>
            <th>
                Imie
            </th>
            <th>
                Nazwisko
            </th>
            <th>
                Priorytet
                </th>

            <th>akcje</th>
        </tr>
    </thead>
    <tbody
        @foreach (var item in @Model)
        {
        <tr>
            <td>
                @item.FirstName
            </td>
            <td>
                @item.LastName
            </td>
            <td>
                @item.Priority
                </td>
            <td>
                <a class="btn btn-primary" asp-action="Edit" asp-controller="Contact" asp-route-id=@item.Id href="/Contact/Edit/@item.Id">Edit</a>
                <a class="btn btn-primary" asp-action="Details" asp-controller="Contact" href="/Contact/Details/@item.Id">Details</a>
                <a class="btn btn-danger " asp-action="Delete" asp-controller="Contact" asp-route-id=@item.Id href="/Contact/Delete/@item.Id">Delete</a>
            </td>
        </tr>
        }
    </tbody>
</table>